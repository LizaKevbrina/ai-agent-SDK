# ========================================
# AI Agent SDK - Environment Configuration
# ========================================

# Application
APP_NAME=AI Real Estate Agent
ENVIRONMENT=production
LOG_LEVEL=INFO

# ========================================
# LLM API Keys
# ========================================

# YandexGPT (Primary)
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_FOLDER_ID=your_folder_id_here

# OpenAI (Alternative)
# OPENAI_API_KEY=sk-...

# Anthropic (Alternative)
# ANTHROPIC_API_KEY=sk-ant-...

# ========================================
# Vector Store & Database
# ========================================

# Supabase (Vector Store)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key_here

# PostgreSQL (Memory)
POSTGRES_URL=postgresql://ai_user:password@postgres:5432/ai_db

# Redis (Cache)
REDIS_URL=redis://redis:6379

# ========================================
# LLM Configuration
# ========================================

DEFAULT_LLM_MODEL=gpt-4
TEMPERATURE=0.7
MAX_TOKENS=2000

# ========================================
# RAG Configuration
# ========================================

SIMILARITY_THRESHOLD=0.7
RAG_TOP_K=5

# ========================================
# Memory Configuration
# ========================================

MEMORY_WINDOW_SIZE=40
DEFAULT_PROMPT_VERSION=v1

# ========================================
# Circuit Breaker
# ========================================

CIRCUIT_BREAKER_FAIL_MAX=5
CIRCUIT_BREAKER_TIMEOUT=60

# ========================================
# Monitoring
# ========================================

PROMETHEUS_PORT=9090

# Sentry (Optional)
# SENTRY_DSN=https://...

# ========================================
# Testing
# ========================================

# Set ENVIRONMENT=testing for tests
# Tests will use these same credentials
